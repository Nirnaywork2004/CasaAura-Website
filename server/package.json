{
  "name": "casaaura-backend",
  "version": "1.0.0",
  "description": "CasaAura RESTful API Backend Service",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx server.ts",
    "seed": "tsx seeds/seedProducts.ts",
    "start": "node dist/server.cjs",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs"
  },
  "keywords": [
    "casaaura",
    "ecommerce",
    "express",
    "mongodb",
    "mongoose"
  ],
  "author": "CasaAura Engineering",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
