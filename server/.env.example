# ==========================================
# CasaAura Backend Environment Configuration
# ==========================================

# Server Port
PORT=3000

# Node Environment (development | test | production)
NODE_ENV=development

# MongoDB Connection URI
# e.g. mongodb+srv://<username>:<password>@cluster.mongodb.net/casaaura?retryWrites=true&w=majority
# or local: mongodb://localhost:27017/casaaura
MONGODB_URI=

# JSON Web Token Secret & Expiry for Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin API Key for protected catalog mutations (POST, PUT, DELETE /api/products)
ADMIN_API_KEY=

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000
